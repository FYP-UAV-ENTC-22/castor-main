# /etc/castor/stack.env: which images this Pi runs. Read by castor-stack.service,
# castor-update.sh and docker compose. Robot identity lives in robot.yaml, not here.

CASTOR_REGISTRY=ghcr.io/fyp-uav-entc-22
# main follows the latest merged build. For a flight day, pin every drone to the
# same build with CASTOR_TAG=sha-<12-char git revision> and run castor-update.
CASTOR_TAG=main
CASTOR_ROBOT_CONFIG=/etc/castor/robot.yaml
