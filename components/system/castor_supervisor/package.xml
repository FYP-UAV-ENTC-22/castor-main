<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>castor_supervisor</name>
  <version>0.1.0</version>
  <description>YASMIN state machine for vehicle modes, BehaviorTree.CPP trees for task sequencing, and the update gate.</description>
  <maintainer email="kiran.g@radskunkworks.com">Kiran Gunathilaka</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>yasmin</depend>
  <depend>behaviortree_cpp</depend>
  <depend>castor_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
