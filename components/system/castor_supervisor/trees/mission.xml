<?xml version="1.0"?>
<!--
  Mission tree, ticked by the supervisor while it is in MISSION.
  Placeholder: confirms the vehicle is armed, then holds for a while. Neither
  leaf commands the vehicle. Real mission steps (take-off, formation, transport)
  replace these once the planning side produces setpoints.
  Editable in Groot2 (BehaviorTree.CPP v4 format).
-->
<root BTCPP_format="4" main_tree_to_execute="Mission">
  <BehaviorTree ID="Mission">
    <Sequence>
      <VehicleArmed/>
      <Hold duration_s="5.0"/>
    </Sequence>
  </BehaviorTree>
</root>
