{
    "name": "CASTOR Planning",
    "dockerComposeFile": ["../../docker/docker-compose.dev.yml"],
    "service": "planning",
    "workspaceFolder": "/home/ws",
    "remoteUser": "castor",
    "initializeCommand": "sh ./.devcontainer/initialize.sh",
    "postCreateCommand": "sh ./.devcontainer/planning/postCreate.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "ms-iot.vscode-ros"
            ]
        }
    }
}
